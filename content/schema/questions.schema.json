{
  "type": "object",
  "additionalProperties": false,
  "required": ["mythfact", "mcq", "anagram"],
  "properties": {
    "mythfact": {
      "type": "array",
      "minItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["category", "q", "options", "answerHash", "salt", "reviewed"],
        "properties": {
          "category": { "type": "string", "minLength": 1 },
          "q": { "type": "string", "minLength": 1 },
          "options": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": { "type": "string", "minLength": 1 }
          },
          "answerHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "salt": { "type": "string", "minLength": 16 },
          "reviewed": { "type": "boolean" }
        }
      }
    },
    "mcq": {
      "type": "array",
      "minItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["category", "q", "options", "answerHash", "salt", "reviewed"],
        "properties": {
          "category": { "type": "string", "minLength": 1 },
          "q": { "type": "string", "minLength": 1 },
          "options": {
            "type": "array",
            "minItems": 4,
            "maxItems": 4,
            "items": { "type": "string", "minLength": 1 }
          },
          "answerHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "salt": { "type": "string", "minLength": 16 },
          "reviewed": { "type": "boolean" }
        }
      }
    },
    "anagram": {
      "type": "array",
      "minItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["category", "q", "hint", "letters", "answerHash", "salt", "reviewed"],
        "properties": {
          "category": { "type": "string", "minLength": 1 },
          "q": { "type": "string", "minLength": 1 },
          "hint": { "type": "string", "minLength": 1 },
          "letters": { "type": "string", "minLength": 2 },
          "answerHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "salt": { "type": "string", "minLength": 16 },
          "reviewed": { "type": "boolean" }
        }
      }
    }
  }
}
