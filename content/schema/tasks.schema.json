{
  "type": "object",
  "minProperties": 1,
  "additionalProperties": {
    "type": "object",
    "additionalProperties": false,
    "required": ["type", "reviewed", "variants"],
    "properties": {
      "type": { "enum": ["mythfact", "mcq", "anagram"] },
      "reviewed": { "type": "boolean" },
      "variants": {
        "type": "array",
        "minItems": 2,
        "maxItems": 3,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["q", "answerHash", "salt"],
          "properties": {
            "q": { "type": "string", "minLength": 1 },
            "options": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 2, "maxItems": 4 },
            "letters": { "type": "string", "minLength": 2 },
            "answerHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "salt": { "type": "string", "minLength": 16 }
          }
        }
      }
    }
  }
}
